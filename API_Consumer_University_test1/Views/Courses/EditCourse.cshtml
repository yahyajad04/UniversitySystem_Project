@model API_Consumer_University_test1.Models.Courses

@{
    ViewData["Title"] = "EditCourse";
}

<h1>EditCourse</h1>

<h4>Courses</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditCourse" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="courseId" value="@Model.Id" />
            <div class="form-group">
                <label value="Course_Name" class="control-label"></label>
                <input type="text" name="Course_Name" value="@Model.Course_Name" class="form-control" />
                <span asp-validation-for="Course_Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input type="text" name="Description" value="@Model.Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-primary">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
